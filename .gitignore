/.cache
/compile_commands.json
/build

# ignore emacs temp files
*~
\#*\#

# ignore vscode settings
.vscode

# ignore vim swap files
.swp

# ignore merge/patch backup files
.orig

# build artifacts from Makefile workflow
/.build/
/.install/
/.update-submodules

# uv lock file (generated, not committed)
/uv.lock

# Python virtual environment
.venv/

# Claude Code local settings
/.claude/settings.local.json

# Paper and blog builds (MPark.WG21, org export)
/papers/generated/
/papers/wording/.stamp
/papers/blog/*.html
*.deps
/docs/html/
/installtest/*/.build/

# Emacs packages installed by .emacs.d/init.el for blog export
/.emacs.d/eln-cache/
/.emacs.d/elpa/
/.emacs.d/elpa-*/
